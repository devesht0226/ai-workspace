# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
ENABLE_API_DOCS=true

# Security — change JWT_SECRET before any shared deployment
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=30

# Database
DATABASE_URL=postgresql+psycopg://aiworkspace:aiworkspace@localhost:5432/aiworkspace

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks

# AI — Ollama-first (use a model you have pulled, e.g. tinyllama on small disks)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=tinyllama
OLLAMA_EMBED_MODEL=nomic-embed-text
# Optional meeting audio STT model name if available in Ollama
OLLAMA_WHISPER_MODEL=

# Optional cloud providers for Model Router
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_CHAT_MODEL=mistral-small-latest
DEFAULT_MODEL_FAMILY=llama
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

REQUIRE_EMAIL_VERIFICATION=false
APP_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
MAIL_FROM=noreply@aiworkspace.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
HYBRID_SEARCH_ENABLED=true
OCR_ENABLED=true

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
